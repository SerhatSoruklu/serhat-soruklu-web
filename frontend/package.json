{
  "name": "frontend",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.20.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "scripts": {
    "ng": "ng",
    "dev": "npm run dev:ssr",
    "start": "npm run start:production",
    "start:production": "node ./scripts/start-production.mjs",
    "dev:ssr": "node ./scripts/dev-ssr.mjs",
    "build": "npm run build:production",
    "build:production": "ng build --configuration production",
    "build:ssr": "npm run build:production",
    "watch": "ng build --watch --configuration development",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "typecheck:watch": "ngc -p tsconfig.app.json --noEmit --watch",
    "test": "ng test",
    "serve:ssr:frontend": "npm run start:production",
    "verify:artifact": "node ./scripts/assert-production-build.mjs",
    "smoke:production": "node ./scripts/smoke-production.mjs",
    "lint": "ng lint",
    "e2e": "playwright test",
    "e2e:smoke:cross-browser": "playwright test --config playwright.smoke.config.ts",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install",
    "e2e:report": "playwright show-report",
    "test:responsive": "npm run e2e"
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/animations": "^21.2.18",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.18",
    "@angular/platform-server": "^21.2.18",
    "@angular/router": "^21.2.18",
    "@angular/ssr": "^21.2.19",
    "@mdi/js": "^7.4.47",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "rxjs": "~7.8.0",
    "simple-icons": "^16.26.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.18",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.1.5",
    "angular-eslint": "21.3.1",
    "eslint": "^10.0.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.56.1",
    "vitest": "^4.0.8"
  }
}
