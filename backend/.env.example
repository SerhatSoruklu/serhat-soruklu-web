# Runtime
NODE_ENV=production
PORT=3000

# Explicit browser origins. Keep this list comma-separated; never use a wildcard.
CORS_ORIGINS=https://serhatsoruklu.com,https://www.serhatsoruklu.com
# Legacy alias accepted for compatibility; prefer CORS_ORIGINS.
# CORS_ORIGIN=https://serhatsoruklu.com

# Number of trusted reverse-proxy hops (normally 1 for a single local proxy).
TRUST_PROXY=1

# Optional database connection. Leave blank when MongoDB is not used.
MONGODB_URI=

# SMTP delivery. Inject SMTP_PASS from the production secret store.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_NAME=api.example.com
SMTP_USER=contact-sender@example.com
SMTP_PASS=replace-with-secret-from-secret-store
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Contact recipients and public site URL.
CONTACT_INTERNAL_TO=contact-inbox@example.com
CONTACT_REPLY_TO=contact-reply@example.com
SERHAT_SITE_URL=https://serhatsoruklu.com

# Nodemailer connection, greeting, and socket-inactivity limits (max 6000 ms).
CONTACT_MAIL_TIMEOUT_MS=5000

# Attempt-based abuse protection (per in-process client IP store).
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_RATE_LIMIT_MAX=5

# In-process duplicate protection. Use a shared store when running multiple workers.
CONTACT_IDEMPOTENCY_TTL_MS=900000
CONTACT_IDEMPOTENCY_MAX_ENTRIES=1000

# Production defaults to one bounded startup verification when this is omitted.
SMTP_VERIFY_ON_START=true
SMTP_VERIFY_TIMEOUT_MS=5000

# API landing-page asset limits.
STATIC_RATE_LIMIT_WINDOW_MS=900000
STATIC_RATE_LIMIT_MAX=600

# Bounded SIGTERM/SIGINT drain period.
SHUTDOWN_TIMEOUT_MS=10000
